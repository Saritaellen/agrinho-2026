<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>EcoIrriga - Contra o Desperdício de Água</title>
    <style>
        :root {
            --azul-escuro: #0f172a;
            --azul-agua: #0284c7;
            --verde-sucesso: #16a34a;
            --vermelho-alerta: #dc2626;
            --cinza-fundo: #f8fafc;
            --branco: #ffffff;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Segoe UI', system-ui, sans-serif;
        }

        body {
            background-color: var(--cinza-fundo);
            color: #334155;
            line-height: 1.6;
        }

        /* Topo */
        header {
            background-color: var(--azul-escuro);
            color: var(--branco);
            padding: 1.2rem 5%;
            text-align: center;
            font-size: 1.2rem;
            font-weight: bold;
            box-shadow: 0 4px 6px rgba(0,0,0,0.05);
        }

        header span { color: var(--azul-agua); }

        .container {
            max-width: 1000px;
            margin: 0 auto;
            padding: 3rem 1.5rem;
        }

        /* Seção do Problema e Solução */
        .bloco-informativo {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 2rem;
            margin-bottom: 3rem;
        }

        .card {
            background: var(--branco);
            padding: 2rem;
            border-radius: 12px;
            box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05);
        }

        .card-problema { border-left: 6px solid var(--vermelho-alerta); }
        .card-solucao { border-left: 6px solid var(--verde-sucesso); }

        h2 {
            font-size: 1.4rem;
            margin-bottom: 1rem;
        }
        .card-problema h2 { color: var(--vermelho-alerta); }
        .card-solucao h2 { color: var(--verde-sucesso); }

        ul {
            list-style-position: inside;
            margin-left: 0.5rem;
        }

        li { margin-bottom: 0.8rem; }

        /* Área do Simulador Prático (Solução em Ação) */
        .simulador {
            background: var(--branco);
            padding: 2.5rem;
            border-radius: 12px;
            box-shadow: 0 10px 15px -3px rgba(0,0,0,0.05);
            border: 1px solid #e2e8f0;
        }

        .simulador h2 {
            color: var(--azul-escuro);
            text-align: center;
            margin-bottom: 1.5rem;
        }

        .campos-grupo {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 1.5rem;
            margin-bottom: 1.5rem;
        }

        label {
            display: block;
            font-weight: 600;
            margin-bottom: 0.5rem;
            font-size: 0.9rem;
        }

        select {
            width: 100%;
            padding: 0.75rem;
            border: 2px solid #cbd5e1;
            border-radius: 6px;
            background-color: var(--branco);
            font-size: 1rem;
            color: #334155;
            outline: none;
        }

        select:focus {
            border-color: var(--azul-agua);
        }

        .btn-calcular {
            display: block;
            width: 100%;
            background-color: var(--azul-agua);
            color: var(--branco);
            border: none;
            padding: 1rem;
            font-size: 1rem;
            font-weight: bold;
            border-radius: 6px;
            cursor: pointer;
            transition: background 0.2s;
        }

        .btn-calcular:hover {
            background-color: #026ca3;
        }

        /* Painel de Resultado */
        .resultado-box {
            margin-top: 1.5rem;
            padding: 1.5rem;
            border-radius: 6px;
            text-align: center;
            font-weight: bold;
            font-size: 1.1rem;
            display: none; /* Inicia escondido */
        }

        .status-parar {
            background-color: #fee2e2;
            color: var(--vermelho-alerta);
            border: 2px solid #fca5a5;
        }

        .status-regar {
            background-color: #dcfce7;
            color: var(--verde-sucesso);
            border: 2px solid #86efac;
        }

        footer {
            background: var(--azul-escuro);
            color: #94a3b8;
            text-align: center;
            padding: 1.5rem;
            font-size: 0.85rem;
            margin-top: 4rem;
        }

        @media (max-width: 600px) {
            .container { padding: 1.5rem 1rem; }
            .simulador { padding: 1.5rem; }
        }
    </style>
</head>
<body>

    <header>
        💧 Eco<span>Irriga</span> — Tecnologia Contra a Irrigação Excessiva
    </header>

    <main class="container">

        <!-- Diagnóstico: Problema vs Solução -->
        <section class="bloco-informativo">
            <div class="card card-problema">
                <h2>⚠️ O Problema: Irrigação Excessiva</h2>
                <ul>
                    <li><strong>Morte por Sufocamento:</strong> O excesso de água expulsa o oxigênio da terra e apodrece as raízes.</li>
                    <li><strong>Perda de Nutrientes:</strong> A água em abundância lava o solo (lixiviação) e leva o adubo embora.</li>
                    <li><strong>Desperdício Caro:</strong> Gasta reservatórios públicos e encarece a conta de energia com bombas ligadas à toa.</li>
                </ul>
            </div>

            <div class="card card-solucao">
                <h2>💡 A Solução: Automação Baseada em Dados</h2>
                <ul>
                    <li><strong>Monitoramento Constante:</strong> Cruzamento de dados de chuva com as características físicas do terreno.</li>
                    <li><strong>Decisão Inteligente:</strong> Algoritmos que determinam o momento exato de abrir ou fechar as válvulas.</li>
                    <li><strong>Economia Real:</strong> Redução de até 40% no consumo de água mantendo a produtividade alta.</li>
                </ul>
            </div>
        </section>

        <!-- Ferramenta Prática: Simulador de Decisão -->
        <section class="simulador">
            <h2>📱 Simulador de Campo Inteligente</h2>
            <p style="text-align: center; margin-bottom: 1.5rem; font-size: 0.95rem;">Mude os parâmetros abaixo para simular o comportamento do nosso sistema automatizado:</p>
            
            <div class="campos-grupo">
                <div>
                    <label for="clima">Previsão do Tempo (Hoje):</label>
                    <select id="clima">
                        <option value="chuva">🌧️ Chovendo ou Previsão de Chuva</option>
                        <option value="nublado">☁️ Nublado / Baixo Calor</option>
                        <option value="sol">☀️ Ensolarado / Muito Calor</option>
                    </select>
                </div>

                <div>
                    <label for="solo">Tipo de Solo da Lavoura:</label>
                    <select id="solo">
                        <option value="argiloso">🧱 Argiloso (Retém muita água)</option>
                        <option value="arenoso">⏳ Arenoso (Seca muito rápido)</option>
                    </select>
                </div>
            </div>

            <button class="btn-calcular" onclick="analisarIrrigacao()">Analisar Necessidade de Irrigação</button>

            <!-- Onde o resultado aparece -->
            <div id="resultado" class="resultado-box"></div>
        </section>

    </main>

    <footer>
        <p>Projeto Agrinho 2026 — Foco em Soluções Sustentáveis e Eficiência Hídrica.</p>
    </footer>

    <!-- Lógica em JavaScript que faz o site funcionar sozinho -->
    <script>
        function analisarIrrigacao() {
            // Pega as escolhas do usuário
            const clima = document.getElementById('clima').value;
            const solo = document.getElementById('solo').value;
            const painelResultado = document.getElementById('resultado');

            // Limpa as classes antigas do painel
            painelResultado.className = "resultado-box";
            painelResultado.style.display = "block";

            // Lógica de tomada de decisão (Solução do problema)
            if (clima === "chuva") {
                painelResultado.innerHTML = "❌ STATUS: SISTEMA DESLIGADO<br><small>Motivo: Choveu ou vai chover. Ligar a irrigação agora causará encharcamento e asfixia das raízes.</small>";
                painelResultado.classList.add("status-parar");
            } 
            else if (clima === "nublado" && solo === "argiloso") {
                painelResultado.innerHTML = "❌ STATUS: SISTEMA DESLIGADO<br><small>Motivo: O solo argiloso já armazena umidade suficiente para dias nublados e frios.</small>";
                painelResultado.classList.add("status-parar");
            } 
            else if (clima === "nublado" && solo === "arenoso") {
                painelResultado.innerHTML = "✅ STATUS: IRRIGAR POR 15 MINUTOS<br><small>Motivo: O solo arenoso seca rápido, necessitando de uma rega curta mesmo sem sol forte.</small>";
                painelResultado.classList.add("status-regar");
            } 
            else if (clima === "sol" && solo === "argiloso") {
                painelResultado.innerHTML = "✅ STATUS: IRRIGAR POR 20 MINUTOS<br><small>Motivo: Sol forte evapora a água superficial, exige rega moderada devido à retenção do solo.</small>";
                painelResultado.classList.add("status-regar");
            } 
            else if (clima === "sol" && solo === "arenoso") {
                painelResultado.innerHTML = "✅ STATUS: IRRIGAR POR 40 MINUTOS<br><small>Motivo: Alerta crítico de ressecamento. Solo arenoso sob sol forte exige o tempo máximo de rega controlada.</small>";
                painelResultado.classList.add("status-regar");
            }
